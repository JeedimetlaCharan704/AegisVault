# AegisVault Production Configuration Example
# Network: Base Sepolia (Chain ID: 84532)
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532

# Multi-Agent Co-Processor Keys
AGENT_PORT=8000
AGENT_SIGNER_ADDRESS=0x2A6261d5e6ce20456aad4Bdf59a30C9CD243f260
AGENT_SIGNER_PRIVATE_KEY=0x_your_agent_private_key_here

# Deployer Account (Fund with free Base Sepolia ETH from faucet)
DEPLOYER_ADDRESS=0x1a099FF069aDF6c45efBFc72FB0967A01FB3a026
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here

# Invariant Guardrail Thresholds
MAX_POOL_ALLOCATION_BPS=4000
MIN_RESERVE_FLOOR_BPS=1000
MAX_SLIPPAGE_BPS=50
CIRCUIT_BREAKER_DRAWDOWN_BPS=500
